# Telegram MTProto API Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Target channels to scrape (comma-separated, leave blank to monitor all incoming chats)
TARGET_CHANNELS=

# MongoDB URI (Optional, defaults to local json fallback if omitted)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=narcotrace
